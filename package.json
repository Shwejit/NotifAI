{
  "name": "notifai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "tsc -p apps/api/tsconfig.json",
    "dev": "tsx watch apps/api/src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint apps/api/src",
    "typecheck": "tsc --noEmit -p apps/api/tsconfig.json",
    "test": "vitest run apps/api/src",
    "start": "node apps/api/dist/index.js",
    "dev:worker": "tsx watch apps/api/src/worker.ts",
    "worker": "node apps/api/dist/worker.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.6.2",
    "prisma": "^6.19.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@fastify/sensible": "^6.0.3",
    "@prisma/client": "^6.19.0",
    "fastify-plugin": "^6.0.0"
  }
}
